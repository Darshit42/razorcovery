# Copy to .env and fill in. .env is gitignored.
#
# The app reads only DATABASE_URL. For AWS RDS with TLS:
#   postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=verify-full&sslrootcert=./global-bundle.pem
# Download the RDS root cert bundle into the repo root first:
#   curl -o global-bundle.pem https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem

PGHOST=your-instance.rds.amazonaws.com
PGPORT=5432
PGDATABASE=postgres
PGUSER=postgres
PGPASSWORD=
PGSSLMODE=verify-full
PGSSLROOTCERT=./global-bundle.pem

DATABASE_URL=postgresql://postgres:<PASSWORD>@your-instance.rds.amazonaws.com:5432/postgres?sslmode=verify-full&sslrootcert=./global-bundle.pem

# Local Postgres alternative (no TLS):
# DATABASE_URL=postgresql://razorcovery:devpass@localhost:5432/razorcovery

# --- Voice agent (Gemini) ---
GOOGLE_API_KEY=your-gemini-api-key

# --- Real outbound telephony (optional) ---
# Set ALL of these and the batch runner places real phone calls via a
# LiveKit outbound SIP trunk. Leave blank and it runs headless Gemini
# conversations instead (no PSTN).
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
SIP_OUTBOUND_TRUNK_ID=          # LiveKit outbound trunk -> Twilio/Plivo/Exotel
SIP_CALLER_ID=                  # optional: number shown to the callee
LIVEKIT_AGENT_NAME=razorcovery-agent
